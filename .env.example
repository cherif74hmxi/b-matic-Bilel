# Copier ce fichier en .env et renseigner les valeurs du projet Supabase
# (Supabase > Project Settings > API). Clé publique uniquement :
# jamais de clé service_role / secret côté front.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Assistant IA (Gemini) : rédaction admin + scan de carte grise (reprise et admin).
# Mettre true une fois l'Edge Function « generate-copy » déployée (--no-verify-jwt)
# et la migration scan_quota exécutée. La clé Gemini n'est JAMAIS ici : c'est un
# secret Supabase.
VITE_AI_ENABLED=false

# Adresse publique du site, sans « / » final (liens absolus du SEO : canonical,
# données structurées, sitemap, aperçus de partage). Ex. : https://www.bmatic.be
VITE_SITE_URL=

# --- Serveur du VPS uniquement (server/index.ts) --------------------------------
# Sans préfixe VITE_ : ces valeurs ne vont JAMAIS dans le site livré au navigateur.
# Email de confirmation des demandes de rappel (/rendez-vous), via l'API Brevo.
# Clé vide = pas d'email de confirmation (le formulaire fonctionne quand même).
BREVO_API_KEY=
MAIL_FROM=contact@bmatic-pare-brise.com
MAIL_REPLY_TO=bmatic63s@gmail.com
